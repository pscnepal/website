        },
        "dislikesCount": {
          "type": "number",
          "description": "Real database-persisted total dislike count."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when stats doc was initialized."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest metric update."
        }
      },
      "required": [
        "itemId",
        "itemType",
        "viewsCount",
        "likesCount",
        "dislikesCount",
        "createdAt",
        "updatedAt"
      ]
    },

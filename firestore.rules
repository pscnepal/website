rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Security & Validation Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'info.pscnepal@gmail.com';
    }

    function isActiveAccount(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && (
          !('status' in get(/databases/$(database)/documents/users/$(userId)).data)
          || get(/databases/$(database)/documents/users/$(userId)).data.status == 'active'
        );
    }

    function isActiveSignedInUser() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Entity Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'role',
          'status',
          'statusReason',
          'targetCadre',
          'phone',
          'adminNotes',
          'statusUpdatedAt',
          'updatedAt',
          'createdAt',
          'lastLoginAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && (!('role' in data) || data.role in ['aspirant', 'admin'])
        && (!('status' in data) || data.status in ['active', 'disabled', 'banned'])
        && (!('statusReason' in data) || (data.statusReason is string && data.statusReason.size() <= 300))
        && (!('targetCadre' in data) || data.targetCadre in ['section-officer', 'nayab-subba', 'kharidar', 'ntc-computer-engineer-7'])
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
        && (!('statusUpdatedAt' in data) || data.statusUpdatedAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    // Entity Validation Blueprint: QuizAttempt
    function isValidQuizAttempt(data) {
      return data.keys().hasAll([
        'id',
        'userId',
        'deckId',
        'deckTitle',
        'mode',
        'totalQuestions',
        'totalMarks',
        'correctCount',
        'wrongCount',
        'unansweredCount',
        'accuracyPercent',
        'pscNetScore',
        'durationSeconds',
        'deadlineSeconds',
        'timedOut',
        'completedAt',
        'createdAt'
      ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'deckId',
          'deckTitle',
          'mode',
          'totalQuestions',
          'totalMarks',
          'correctCount',
          'wrongCount',
          'unansweredCount',
          'accuracyPercent',
          'pscNetScore',
          'durationSeconds',
          'deadlineSeconds',
          'timedOut',
          'questionOutcomes',
          'completedAt',
          'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.deckId is string
        && data.deckId.size() >= 1
        && data.deckId.size() <= 160
        && data.deckTitle is string
        && data.deckTitle.size() >= 1
        && data.deckTitle.size() <= 220
        && data.mode in ['exam', 'study']
        && data.totalQuestions is number
        && data.totalQuestions >= 1
        && data.totalQuestions <= 500
        && data.totalMarks is number
        && data.totalMarks >= 0
        && data.totalMarks <= 1000
        && data.correctCount is number
        && data.correctCount >= 0
        && data.correctCount <= data.totalQuestions
        && data.wrongCount is number
        && data.wrongCount >= 0
        && data.wrongCount <= data.totalQuestions
        && data.unansweredCount is number
        && data.unansweredCount >= 0
        && data.unansweredCount <= data.totalQuestions
        && data.accuracyPercent is number
        && data.accuracyPercent >= 0
        && data.accuracyPercent <= 100
        && data.pscNetScore is number
        && data.pscNetScore >= 0
        && data.pscNetScore <= data.totalMarks
        && data.durationSeconds is number
        && data.durationSeconds >= 0
        && data.durationSeconds <= 36000
        && data.deadlineSeconds is number
        && data.deadlineSeconds >= 1
        && data.deadlineSeconds <= 36000
        && data.timedOut is bool
        && (!('questionOutcomes' in data) || (data.questionOutcomes is map && data.questionOutcomes.size() <= 300))
        && data.completedAt is string
        && data.completedAt.size() >= 1
        && data.completedAt.size() <= 64
        && data.createdAt is timestamp;
    }

    // Entity Validation Blueprint: FlaggedQuestion
    function isValidFlaggedQuestion(data) {
      return data.keys().hasAll(['questionId', 'userId', 'flaggedAt', 'source', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['questionId', 'userId', 'flaggedAt', 'source', 'deckTitle', 'cadreId', 'reason', 'note', 'createdAt', 'updatedAt'])
        && isValidId(data.questionId)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.flaggedAt is string
        && data.flaggedAt.size() >= 1
        && data.flaggedAt.size() <= 64
        && data.source in ['quiz', 'simulation', 'dashboard']
        && (!('deckTitle' in data) || (data.deckTitle is string && data.deckTitle.size() <= 220))
        && (!('cadreId' in data) || (data.cadreId is string && data.cadreId.size() <= 64))
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 500))
        && (!('note' in data) || (data.note is string && data.note.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity Validation Blueprint: UserItemReaction
    function isValidUserItemReaction(data) {
      return data.keys().hasAll(['itemId', 'userId', 'itemType', 'reaction', 'viewCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['itemId', 'userId', 'itemType', 'reaction', 'viewCount', 'createdAt', 'updatedAt'])
        && isValidId(data.itemId)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.itemType in ['question', 'material', 'affair']
        && data.reaction in ['like', 'dislike', 'none']
        && data.viewCount is number
        && data.viewCount >= 0
        && data.viewCount <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity Validation Blueprint: ItemStats
    function isValidItemStats(data) {
      return data.keys().hasAll(['itemId', 'itemType', 'viewsCount', 'likesCount', 'dislikesCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['itemId', 'itemType', 'viewsCount', 'likesCount', 'dislikesCount', 'createdAt', 'updatedAt'])
        && isValidId(data.itemId)
        && data.itemType in ['question', 'material', 'affair']
        && data.viewsCount is number
        && data.viewsCount >= 0
        && data.viewsCount <= 10000000
        && data.likesCount is number
        && data.likesCount >= 0
        && data.likesCount <= 1000000
        && data.dislikesCount is number
        && data.dislikesCount >= 0
        && data.dislikesCount <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity Validation Blueprints: User Study Workspaces
    function isValidWorkspacePreferences(data, userId) {
      return data.keys().hasAll([
        'userId',
        'theme',
        'defaultReadingMode',
        'defaultSoundEnabled',
        'preferredQuizMode',
        'preferredWrittenLanguage',
        'targetCadreId',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'userId',
          'theme',
          'defaultReadingMode',
          'defaultSoundEnabled',
          'preferredQuizMode',
          'preferredWrittenLanguage',
          'targetCadreId',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && data.theme in ['light', 'dark']
        && data.defaultReadingMode in ['standard', 'flipbook']
        && data.defaultSoundEnabled is bool
        && data.preferredQuizMode in ['exam', 'study']
        && data.preferredWrittenLanguage in ['bilingual', 'en', 'ne']
        && data.targetCadreId in ['section-officer', 'nayab-subba', 'kharidar', 'ntc-computer-engineer-7']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceSyllabus(data, userId) {
      return data.keys().hasAll([
        'userId',
        'completedUnitIds',
        'completedTopicIds',
        'bookmarkedUnitIds',
        'examChecklist',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'userId',
          'completedUnitIds',
          'completedTopicIds',
          'bookmarkedUnitIds',
          'examChecklist',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && data.completedUnitIds is list
        && data.completedUnitIds.size() <= 500
        && (data.completedUnitIds.size() == 0 || data.completedUnitIds[0] is string)
        && data.completedTopicIds is list
        && data.completedTopicIds.size() <= 2500
        && (data.completedTopicIds.size() == 0 || data.completedTopicIds[0] is string)
        && data.bookmarkedUnitIds is list
        && data.bookmarkedUnitIds.size() <= 500
        && (data.bookmarkedUnitIds.size() == 0 || data.bookmarkedUnitIds[0] is string)
        && data.examChecklist is map
        && data.examChecklist.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceBookmarks(data, userId) {
      return data.keys().hasAll(['userId', 'pyqIds', 'affairIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'pyqIds', 'affairIds', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.pyqIds is list
        && data.pyqIds.size() <= 500
        && (data.pyqIds.size() == 0 || data.pyqIds[0] is string)
        && data.affairIds is list
        && data.affairIds.size() <= 500
        && (data.affairIds.size() == 0 || data.affairIds[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceFlashcards(data, userId) {
      return data.keys().hasAll(['userId', 'progressMap', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'progressMap', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.progressMap is map
        && data.progressMap.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceLibrary(data, userId) {
      return data.keys().hasAll(['userId', 'recentBooks', 'readingProgress', 'readingStats', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'recentBooks', 'readingProgress', 'readingStats', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.recentBooks is list
        && data.recentBooks.size() <= 12
        && (data.recentBooks.size() == 0 || data.recentBooks[0] is map)
        && data.readingProgress is map
        && data.readingProgress.size() <= 200
        && data.readingStats is map
        && data.readingStats.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWrittenProgress(data, questionId) {
      return data.keys().hasAll([
        'userId',
        'questionId',
        'status',
        'checkedRubricIndices',
        'draftAnswer',
        'timeSpentSeconds',
        'clientUpdatedAt',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'userId',
          'questionId',
          'status',
          'checkedRubricIndices',
          'draftAnswer',
          'timeSpentSeconds',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidId(data.questionId)
        && data.questionId == questionId
        && data.status in ['unseen', 'practicing', 'mastered']
        && data.checkedRubricIndices is list
        && data.checkedRubricIndices.size() <= 50
        && (data.checkedRubricIndices.size() == 0 || data.checkedRubricIndices[0] is number)
        && data.draftAnswer is string
        && data.draftAnswer.size() <= 30000
        && data.timeSpentSeconds is number
        && data.timeSpentSeconds >= 0
        && data.timeSpentSeconds <= 360000
        && data.clientUpdatedAt is string
        && data.clientUpdatedAt.size() >= 1
        && data.clientUpdatedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWrittenEvaluation(data, evalId) {
      return data.keys().hasAll([
        'id',
        'userId',
        'questionId',
        'questionTitleNe',
        'questionTitleEn',
        'marks',
        'date',
        'evaluatedAt',
        'scoreIntro',
        'scoreCore',
        'scoreStatutes',
        'scoreConclusion',
        'totalScore',
        'timeSpentSeconds',
        'wordCount',
        'userDraft',
        'feedbackNotes',
        'createdAt'
      ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'questionId',
          'questionTitleNe',
          'questionTitleEn',
          'marks',
          'date',
          'evaluatedAt',
          'scoreIntro',
          'scoreCore',
          'scoreStatutes',
          'scoreConclusion',
          'totalScore',
          'timeSpentSeconds',
          'wordCount',
          'userDraft',
          'feedbackNotes',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.id == evalId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidId(data.questionId)
        && data.questionTitleNe is string && data.questionTitleNe.size() <= 400
        && data.questionTitleEn is string && data.questionTitleEn.size() <= 400
        && data.marks in [5, 10]
        && data.date is string && data.date.size() <= 64
        && data.evaluatedAt is string && data.evaluatedAt.size() >= 1 && data.evaluatedAt.size() <= 64
        && data.scoreIntro is number && data.scoreIntro >= 0 && data.scoreIntro <= data.marks
        && data.scoreCore is number && data.scoreCore >= 0 && data.scoreCore <= data.marks
        && data.scoreStatutes is number && data.scoreStatutes >= 0 && data.scoreStatutes <= data.marks
        && data.scoreConclusion is number && data.scoreConclusion >= 0 && data.scoreConclusion <= data.marks
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= data.marks
        && data.timeSpentSeconds is number && data.timeSpentSeconds >= 0 && data.timeSpentSeconds <= 36000
        && data.wordCount is number && data.wordCount >= 0 && data.wordCount <= 50000
        && data.userDraft is string && data.userDraft.size() <= 30000
        && data.feedbackNotes is string && data.feedbackNotes.size() <= 5000
        && data.createdAt is timestamp;
    }

    function isValidSimulationRun(data, runId) {
      return data.keys().hasAll([
        'id',
        'userId',
        'presetId',
        'presetTitle',
        'cadreId',
        'simulationType',
        'fullMarks',
        'passMarks',
        'grossMarks',
        'negativeDeduction',
        'netMarks',
        'percentage',
        'passed',
        'totalItems',
        'attemptedItems',
        'correctItems',
        'wrongItems',
        'durationSeconds',
        'allocatedSeconds',
        'rollNumber',
        'bookletKey',
        'completedAt',
        'createdAt'
      ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'presetId',
          'presetTitle',
          'cadreId',
          'simulationType',
          'fullMarks',
          'passMarks',
          'grossMarks',
          'negativeDeduction',
          'netMarks',
          'percentage',
          'passed',
          'totalItems',
          'attemptedItems',
          'correctItems',
          'wrongItems',
          'durationSeconds',
          'allocatedSeconds',
          'rollNumber',
          'bookletKey',
          'completedAt',
          'createdAt'
        ])
        && isValidId(data.id)
        && data.id == runId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.presetId is string && data.presetId.size() >= 1 && data.presetId.size() <= 128
        && data.presetTitle is string && data.presetTitle.size() >= 1 && data.presetTitle.size() <= 220
        && data.cadreId in ['section-officer', 'nayab-subba', 'kharidar', 'ntc-computer-engineer-7']
        && data.simulationType in ['omr-hall', 'written-hall']
        && data.fullMarks is number && data.fullMarks >= 1 && data.fullMarks <= 1000
        && data.passMarks is number && data.passMarks >= 0 && data.passMarks <= data.fullMarks
        && data.grossMarks is number && data.grossMarks >= 0 && data.grossMarks <= data.fullMarks
        && data.negativeDeduction is number && data.negativeDeduction >= 0 && data.negativeDeduction <= data.fullMarks
        && data.netMarks is number && data.netMarks >= 0 && data.netMarks <= data.fullMarks
        && data.percentage is number && data.percentage >= 0 && data.percentage <= 100
        && data.passed is bool
        && data.totalItems is number && data.totalItems >= 1 && data.totalItems <= 500
        && data.attemptedItems is number && data.attemptedItems >= 0 && data.attemptedItems <= data.totalItems
        && data.correctItems is number && data.correctItems >= 0 && data.correctItems <= data.totalItems
        && data.wrongItems is number && data.wrongItems >= 0 && data.wrongItems <= data.totalItems
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 36000
        && data.allocatedSeconds is number && data.allocatedSeconds >= 1 && data.allocatedSeconds <= 36000
        && data.rollNumber is string && data.rollNumber.size() <= 64
        && data.bookletKey in ['A', 'B', 'C', 'D']
        && data.completedAt is string && data.completedAt.size() >= 1 && data.completedAt.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidContactInquiry(data, inquiryId) {
      return data.keys().hasAll([
        'id',
        'userId',
        'ticketCode',
        'name',
        'email',
        'category',
        'reference',
        'message',
        'status',
        'clientCreatedAt',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'ticketCode',
          'name',
          'email',
          'category',
          'reference',
          'message',
          'status',
          'adminReply',
          'respondedBy',
          'respondedAt',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == inquiryId
        && isValidId(data.userId)
        && data.ticketCode is string && data.ticketCode.size() >= 1 && data.ticketCode.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.category in ['general', 'quiz-errata', 'material-request', 'reader-support']
        && data.reference is string && data.reference.size() <= 300
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 4000
        && data.status in ['open', 'in-review', 'resolved']
        && (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 2000))
        && (!('respondedBy' in data) || (data.respondedBy is string && data.respondedBy.size() <= 128))
        && (!('respondedAt' in data) || data.respondedAt is timestamp)
        && data.clientCreatedAt is string && data.clientCreatedAt.size() >= 1 && data.clientCreatedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Contact & Errata Inquiries Collection
    match /contactInquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && (
        (isVerifiedUser() && existing().userId == request.auth.uid)
        || isAdmin()
      );
      allow list: if (isVerifiedUser() && existing().userId == request.auth.uid)
        || isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(inquiryId)
        && isValidContactInquiry(incoming(), inquiryId)
        && isActiveSignedInUser()
        && incoming().userId == request.auth.uid
        && incoming().status == 'open'
        && !('adminReply' in incoming())
        && !('respondedBy' in incoming())
        && !('respondedAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(inquiryId)
        && isValidContactInquiry(incoming(), inquiryId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().ticketCode == existing().ticketCode
        && incoming().name == existing().name
        && incoming().email == existing().email
        && incoming().category == existing().category
        && incoming().reference == existing().reference
        && incoming().message == existing().message
        && incoming().clientCreatedAt == existing().clientCreatedAt
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().respondedBy == request.auth.uid
        && (!('respondedAt' in incoming()) || incoming().respondedAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'respondedBy', 'respondedAt', 'updatedAt']);
      allow delete: if isValidId(inquiryId) && (
        (isOwner(existing().userId) && isActiveAccount(existing().userId))
        || isAdmin()
      );
    }

    // Public Non-PII Community Item Stats (Views, Likes, Dislikes)
    match /itemStats/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if existing().itemType in ['question', 'material', 'affair'];
      allow create: if isVerifiedUser()
        && isValidId(itemId)
        && isValidItemStats(incoming())
        && isActiveSignedInUser()
        && incoming().itemId == itemId
        && incoming().likesCount <= 1
        && incoming().dislikesCount <= 1
        && incoming().viewsCount <= 100
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/itemReactions/$(itemId));
      allow update: if isVerifiedUser()
        && isValidId(itemId)
        && isValidItemStats(incoming())
        && isActiveSignedInUser()
        && incoming().itemId == existing().itemId
        && incoming().itemType == existing().itemType
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'likesCount', 'dislikesCount', 'updatedAt'])
        && incoming().likesCount - existing().likesCount >= -1
        && incoming().likesCount - existing().likesCount <= 1
        && incoming().dislikesCount - existing().dislikesCount >= -1
        && incoming().dislikesCount - existing().dislikesCount <= 1
        && incoming().viewsCount >= existing().viewsCount
        && incoming().viewsCount - existing().viewsCount <= 100
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/itemReactions/$(itemId));
      allow delete: if false;
    }

    // Strict Owner-Only + Verified Admin Governance User Profiles (PII Isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time
        && (!('role' in incoming()) || incoming().role == 'aspirant')
        && (!('status' in incoming()) || incoming().status == 'active')
        && !('statusReason' in incoming())
        && !('adminNotes' in incoming())
        && !('statusUpdatedAt' in incoming())
        && !('updatedAt' in incoming());
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          (
            isOwner(userId)
            && (!('status' in existing()) || existing().status == 'active')
            && (
              (
                incoming().lastLoginAt == request.time
                && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'lastLoginAt'])
              )
              ||
              (
                incoming().lastLoginAt == existing().lastLoginAt
                && incoming().updatedAt == request.time
                && incoming().diff(existing()).affectedKeys().hasOnly(['targetCadre', 'updatedAt'])
              )
            )
          )
          ||
          (
            isAdmin()
            && incoming().lastLoginAt == existing().lastLoginAt
            && incoming().updatedAt == request.time
            && (
              userId != request.auth.uid
              || (!('status' in incoming()) || incoming().status == 'active')
            )
            && (
              !incoming().diff(existing()).affectedKeys().hasAny(['status', 'statusReason', 'statusUpdatedAt'])
              || incoming().statusUpdatedAt == request.time
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'email',
              'photoURL',
              'role',
              'status',
              'statusReason',
              'targetCadre',
              'phone',
              'adminNotes',
              'statusUpdatedAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;

      // User's Completed Quiz & OMR Simulation Attempts
      match /quizAttempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid)
          || (isAdmin() && existing().userId == userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(attemptId)
          && isValidQuizAttempt(incoming())
          && isActiveAccount(userId)
          && incoming().id == attemptId
          && incoming().userId == userId
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(attemptId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      // User's Flagged Questions for Review
      match /flaggedQuestions/{questionId} {
        allow get: if isValidId(userId) && isValidId(questionId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid)
          || (isAdmin() && existing().userId == userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(questionId)
          && isValidFlaggedQuestion(incoming())
          && isActiveAccount(userId)
          && incoming().questionId == questionId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(questionId)
          && isValidFlaggedQuestion(incoming())
          && isActiveAccount(userId)
          && incoming().questionId == existing().questionId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['flaggedAt', 'source', 'deckTitle', 'cadreId', 'reason', 'note', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(questionId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      // User's Personal Views & Like/Dislike Reactions
      match /itemReactions/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid)
          || (isAdmin() && existing().userId == userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(itemId)
          && isValidUserItemReaction(incoming())
          && isActiveAccount(userId)
          && incoming().itemId == itemId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(itemId)
          && isValidUserItemReaction(incoming())
          && isActiveAccount(userId)
          && incoming().itemId == existing().itemId
          && incoming().userId == existing().userId
          && incoming().itemType == existing().itemType
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['reaction', 'viewCount', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(itemId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      // User's Synced Study Workspaces (Preferences, Syllabus, Bookmarks, Flashcards, Library)
      match /workspace/preferences {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspacePreferences(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspacePreferences(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'theme',
            'defaultReadingMode',
            'defaultSoundEnabled',
            'preferredQuizMode',
            'preferredWrittenLanguage',
            'targetCadreId',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      match /workspace/syllabus {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspaceSyllabus(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspaceSyllabus(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'completedUnitIds',
            'completedTopicIds',
            'bookmarkedUnitIds',
            'examChecklist',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      match /workspace/bookmarks {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspaceBookmarks(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspaceBookmarks(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['pyqIds', 'affairIds', 'updatedAt']);
        allow delete: if isValidId(userId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      match /workspace/flashcards {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspaceFlashcards(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspaceFlashcards(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['progressMap', 'updatedAt']);
        allow delete: if isValidId(userId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      match /workspace/library {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspaceLibrary(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isActiveAccount(userId)
          && isValidWorkspaceLibrary(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'recentBooks',
            'readingProgress',
            'readingStats',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      // User's Per-Question Written Study Drafts & Rubric Progress
      match /writtenProgress/{questionId} {
        allow get: if isValidId(userId) && isValidId(questionId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid)
          || (isAdmin() && existing().userId == userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(questionId)
          && isValidWrittenProgress(incoming(), questionId)
          && isActiveAccount(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(questionId)
          && isValidWrittenProgress(incoming(), questionId)
          && isActiveAccount(userId)
          && incoming().userId == existing().userId
          && incoming().questionId == existing().questionId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'checkedRubricIndices',
            'draftAnswer',
            'timeSpentSeconds',
            'clientUpdatedAt',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(questionId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      // User's Written Answer Evaluator Scorecards
      match /writtenEvaluations/{evalId} {
        allow get: if isValidId(userId) && isValidId(evalId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid)
          || (isAdmin() && existing().userId == userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(evalId)
          && isValidWrittenEvaluation(incoming(), evalId)
          && isActiveAccount(userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(evalId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }

      // User's Completed Exam Hall Simulations (OMR & Written Hall)
      match /simulationRuns/{runId} {
        allow get: if isValidId(userId) && isValidId(runId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid)
          || (isAdmin() && existing().userId == userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(runId)
          && isValidSimulationRun(incoming(), runId)
          && isActiveAccount(userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(runId) && (
          (isOwner(userId) && isActiveAccount(userId))
          || (isAdmin() && userId != request.auth.uid)
        );
      }
    }

    // Entity Validation Blueprint: QuizQuestionOverride
    function isValidQuizQuestionOverride(data, questionId) {
      return data.keys().hasAll([
        'id',
        'isDeleted',
        'level',
        'service',
        'group',
        'post',
        'paper',
        'subject',
        'topicId',
        'topic',
        'subtopicId',
        'subtopic',
        'question',
        'options',
        'correct_options',
        'is_multi_select',
        'explanation',
        'difficulty',
        'marks',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'id',
          'isDeleted',
          'level',
          'service',
          'group',
          'post',
          'paper',
          'subject',
          'topicId',
          'topic',
          'subtopicId',
          'subtopic',
          'question',
          'questionNe',
          'options',
          'correct_options',
          'is_multi_select',
          'explanation',
          'explanationNe',
          'difficulty',
          'marks',
          'sourceTitle',
          'sourcePath',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == questionId
        && data.isDeleted is bool
        && data.level is string && data.level.size() >= 1 && data.level.size() <= 160
        && data['service'] is string && data['service'].size() >= 1 && data['service'].size() <= 160
        && data.group is string && data.group.size() >= 1 && data.group.size() <= 160
        && data.post is string && data.post.size() >= 1 && data.post.size() <= 200
        && data.paper is string && data.paper.size() >= 1 && data.paper.size() <= 160
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 160
        && data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 128
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200
        && data.subtopicId is string && data.subtopicId.size() >= 1 && data.subtopicId.size() <= 128
        && data.subtopic is string && data.subtopic.size() >= 1 && data.subtopic.size() <= 200
        && data.question is string && data.question.size() >= 1 && data.question.size() <= 3000
        && (!('questionNe' in data) || (data.questionNe is string && data.questionNe.size() <= 3000))
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 6 && data.options[0] is map
        && data.correct_options is list && data.correct_options.size() >= 1 && data.correct_options.size() <= 6 && data.correct_options[0] is string
        && data.is_multi_select is bool
        && data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 5000
        && (!('explanationNe' in data) || (data.explanationNe is string && data.explanationNe.size() <= 5000))
        && data.difficulty in ['Easy', 'Medium', 'Hard']
        && data.marks is number && data.marks >= 0.5 && data.marks <= 20
        && (!('sourceTitle' in data) || (data.sourceTitle is string && data.sourceTitle.size() <= 300))
        && (!('sourcePath' in data) || (data.sourcePath is string && data.sourcePath.size() <= 512))
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Entity Validation Blueprint: LocalizedWrittenAnswerBlock
    function isValidWrittenLocalizedBlock(block) {
      return block is map
        && block.keys().hasAll(['title', 'question', 'marksAllocation', 'introduction', 'sections', 'conclusion'])
        && block.keys().hasOnly(['title', 'question', 'marksAllocation', 'introduction', 'sections', 'conclusion'])
        && block.title is string && block.title.size() >= 1 && block.title.size() <= 400
        && block.question is string && block.question.size() >= 1 && block.question.size() <= 3000
        && block.marksAllocation is string && block.marksAllocation.size() >= 1 && block.marksAllocation.size() <= 120
        && block.introduction is string && block.introduction.size() >= 1 && block.introduction.size() <= 5000
        && block.sections is list && block.sections.size() >= 1 && block.sections.size() <= 20 && block.sections[0] is map
        && block.conclusion is string && block.conclusion.size() >= 1 && block.conclusion.size() <= 3000;
    }

    // Entity Validation Blueprint: WrittenQuestionOverride
    function isValidWrittenQuestionOverride(data, questionId) {
      return data.keys().hasAll([
        'id',
        'isDeleted',
        'paper',
        'subject',
        'postTarget',
        'marks',
        'recommendedMinutes',
        'questionType',
        'sourceTitle',
        'sourcePath',
        'en',
        'ne',
        'rubric',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'id',
          'isDeleted',
          'paper',
          'subject',
          'postTarget',
          'marks',
          'recommendedMinutes',
          'questionType',
          'sourceTitle',
          'sourcePath',
          'en',
          'ne',
          'rubric',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == questionId
        && data.isDeleted is bool
        && data.paper in [
          'Paper II: Governance Systems',
          'Paper III: Contemporary Issues & Development',
          'Paper IV: Service Delivery & Case Analysis',
          'NTC Paper II: Computer Engineering'
        ]
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200
        && data.postTarget is string && data.postTarget.size() >= 1 && data.postTarget.size() <= 200
        && data.marks in [5, 10]
        && data.recommendedMinutes is number && data.recommendedMinutes >= 1 && data.recommendedMinutes <= 120
        && data.questionType in ['Short Analytical', 'Long Analytical', 'Case Study']
        && data.sourceTitle is string && data.sourceTitle.size() >= 1 && data.sourceTitle.size() <= 300
        && data.sourcePath is string && data.sourcePath.size() >= 1 && data.sourcePath.size() <= 512
        && isValidWrittenLocalizedBlock(data.en)
        && isValidWrittenLocalizedBlock(data.ne)
        && data.rubric is list && data.rubric.size() >= 1 && data.rubric.size() <= 30 && data.rubric[0] is map
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Public Non-PII Admin-Managed Objective MCQ Question Overrides
    match /quizQuestions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if existing().isDeleted in [true, false];
      allow create: if isAdmin()
        && isValidId(questionId)
        && isValidQuizQuestionOverride(incoming(), questionId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(questionId)
        && isValidQuizQuestionOverride(incoming(), questionId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'isDeleted',
          'level',
          'service',
          'group',
          'post',
          'paper',
          'subject',
          'topicId',
          'topic',
          'subtopicId',
          'subtopic',
          'question',
          'questionNe',
          'options',
          'correct_options',
          'is_multi_select',
          'explanation',
          'explanationNe',
          'difficulty',
          'marks',
          'sourceTitle',
          'sourcePath',
          'updatedBy',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(questionId);
    }

    // Public Non-PII Admin-Managed Written Question Overrides
    match /writtenQuestions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if existing().isDeleted in [true, false];
      allow create: if isAdmin()
        && isValidId(questionId)
        && isValidWrittenQuestionOverride(incoming(), questionId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(questionId)
        && isValidWrittenQuestionOverride(incoming(), questionId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'isDeleted',
          'paper',
          'subject',
          'postTarget',
          'marks',
          'recommendedMinutes',
          'questionType',
          'sourceTitle',
          'sourcePath',
          'en',
          'ne',
          'rubric',
          'updatedBy',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(questionId);
    }

    // Entity Validation Blueprint: ReadingMaterialOverride
    function isValidReadingMaterialOverride(data, materialId) {
      return data.keys().hasAll([
        'id',
        'isDeleted',
        'categoryId',
        'title',
        'authority',
        'codeOrEdition',
        'pages',
        'path',
        'description',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'id',
          'isDeleted',
          'categoryId',
          'categoryName',
          'categorySubtitle',
          'categoryDescription',
          'title',
          'authority',
          'codeOrEdition',
          'pages',
          'path',
          'description',
          'externalSourceUrl',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == materialId
        && data.isDeleted is bool
        && data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 128
        && (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 200))
        && (!('categorySubtitle' in data) || (data.categorySubtitle is string && data.categorySubtitle.size() <= 240))
        && (!('categoryDescription' in data) || (data.categoryDescription is string && data.categoryDescription.size() <= 800))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.authority is string && data.authority.size() >= 1 && data.authority.size() <= 240
        && data.codeOrEdition is string && data.codeOrEdition.size() >= 1 && data.codeOrEdition.size() <= 160
        && data.pages is number && data.pages >= 1 && data.pages <= 5000
        && data.path is string && data.path.size() >= 1 && data.path.size() <= 1000
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
        && (!('externalSourceUrl' in data) || (data.externalSourceUrl is string && data.externalSourceUrl.size() <= 1000))
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

